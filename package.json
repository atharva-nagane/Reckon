{
  "name": "reckon",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/engine",
    "apps/dashboard"
  ],
  "scripts": {
    "engine:dev": "npm run dev -w packages/engine",
    "engine:start": "npm run start -w packages/engine",
    "engine:test": "npm run test -w packages/engine",
    "engine:lint": "npm run lint -w packages/engine",
    "dashboard:dev": "npm run dev -w apps/dashboard",
    "dashboard:build": "npm run build -w apps/dashboard",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "npm run migrate -w packages/engine",
    "db:seed": "npm run seed -w packages/engine",
    "chaos": "npm run chaos -w packages/engine",
    "reconcile": "npm run reconcile -w packages/engine"
  }
}
